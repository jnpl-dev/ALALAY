APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local dev uses MySQL too — the app's migrations are MySQL-only (ENUM ALTERs).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alalay
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true  # production: cookie over HTTPS only

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Production (Railway) uses Resend because SMTP egress is blocked:
#   MAIL_MAILER=resend
#   MAIL_FROM_ADDRESS=onboarding@resend.dev
#   RESEND_API_KEY=re_...
# Resend's free sender only delivers to the account owner. Set this to force
# every outgoing email to a single inbox during trial (leave unset in prod):
#   MAIL_TEST_RECIPIENT=you@example.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Supabase Storage (S3-compatible; use FILESYSTEM_DISK=supabase in production)
SUPABASE_KEY=
SUPABASE_SECRET=
SUPABASE_STORAGE_REGION=ap-northeast-2
SUPABASE_STORAGE_BUCKET=alalay-docs
SUPABASE_STORAGE_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3

VITE_APP_NAME="${APP_NAME}"

# Backup
BACKUP_ENCRYPT_PASS=
BACKUP_RETENTION_DAYS=30
BACKUP_TEST_DATABASE=alalay_backup_test

# Supabase Backup Storage (separate bucket from alalay-docs)
SUPABASE_BACKUP_BUCKET=alalay-backups

# SMS API (PhilSMS)
SMS_DRIVER=philsms
PHILSMS_API_TOKEN=
SMS_API_ENDPOINT=https://dashboard.philsms.com/api/v3/sms/send
SMS_SENDER_NAME=PhilSMS

# Emergency Maintenance
APP_MAINTENANCE_SECRET=

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
